---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageContainer from "../components/PageContainer.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { projects } from "../data/projects";
---

<BaseLayout title="Projects" description="Open-source RF, SIGINT, and wardriving tooling.">
  <PageContainer>
    <h1 class="font-mono text-2xl font-bold mb-2">Projects</h1>
    <p class="text-muted mb-8">Open-source tools built for RF, SIGINT, and wardriving work.</p>
    <div>
      {projects.map((project) => <ProjectCard project={project} />)}
    </div>
  </PageContainer>
</BaseLayout>
