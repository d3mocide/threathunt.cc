---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageContainer from "../components/PageContainer.astro";
import FlasherCard from "../components/FlasherCard.astro";
import { flashers } from "../data/flashers";
---

<BaseLayout title="Web Flashers" description="Browser-based Web Serial firmware installers and web flashers.">
  <PageContainer>
    <h1 class="font-mono text-2xl font-bold mb-2">Web Flashers</h1>
    <p class="text-muted mb-8">
      Browser-based Web Serial firmware installers hosted on GitHub Pages for ESP32 and M5Stack devices.
    </p>
    <div>
      {flashers.map((flasher) => <FlasherCard flasher={flasher} />)}
    </div>
  </PageContainer>
</BaseLayout>
