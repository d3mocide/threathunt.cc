    <div class="py-24 text-center">
      <p class="font-mono text-accent text-sm mb-2">404</p>
      <h1 class="font-mono text-2xl font-bold mb-4">Page not found</h1>
      <a href="/" class="text-accent hover:underline">&larr; back home</a>
    </div>
  </PageContainer>
</BaseLayout>
