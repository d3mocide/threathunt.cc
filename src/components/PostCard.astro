---
import TagPill from "./TagPill.astro";

interface Props {
  href: string;
  title: string;
  date: Date;
  tags: string[];
  description?: string;
}

const { href, title, date, tags, description } = Astro.props;
const formatted = date.toLocaleDateString("en-US", {
  year: "numeric",
  month: "short",
  day: "numeric",
});
---

<article class="group py-6 border-b border-border last:border-0">
  <a href={href} class="block">
    <div class="flex items-baseline justify-between gap-4 flex-wrap">
      <h2 class="font-mono text-lg font-semibold group-hover:text-accent transition-colors">
        {title}
      </h2>
      <time datetime={date.toISOString()} class="text-xs text-muted font-mono shrink-0">
        {formatted}
      </time>
    </div>
    {description && <p class="mt-2 text-muted">{description}</p>}
  </a>
  {
    tags.length > 0 && (
      <div class="mt-3 flex flex-wrap gap-2">
        {tags.map((tag) => (
          <TagPill tag={tag} />
        ))}
      </div>
    )
  }
</article>
