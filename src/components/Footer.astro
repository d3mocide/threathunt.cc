---
import { site } from "../config";

const year = new Date().getFullYear();
---

<footer class="border-t border-border">
  <div
    class="max-w-3xl mx-auto px-4 py-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-sm text-muted font-mono"
  >
    <p>&copy; {year} {site.author.name}</p>
    <div class="flex items-center gap-4">
      <a
        href={site.social.github}
        target="_blank"
        rel="noopener noreferrer me"
        class="hover:text-accent transition-colors"
      >
        github
      </a>
      <a
        href={site.social.twitter}
        target="_blank"
        rel="noopener noreferrer me"
        class="hover:text-accent transition-colors"
      >
        twitter
      </a>
      <a href={`mailto:${site.author.email}`} class="hover:text-accent transition-colors"> email </a>
      <a href="/rss.xml" class="hover:text-accent transition-colors">rss</a>
    </div>
  </div>
</footer>
